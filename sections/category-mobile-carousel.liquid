{% assign collection_found = false %}
{% assign hasSelected = '' %}   

{%- for item in section.settings.show_in_collection -%}
    {% assign hasSelected = 'true' %}
    {%- if item.handle == collection.handle -%}
        {% assign collection_found = true %}
        {% break %}
    {%- endif -%}
{%- endfor -%}

{%- if collection_found == true or hasSelected == '' -%}
    {%- if section.blocks.size -%}
        <style>
            .hide-bubble {
                display: none !important;
                }

            .main-carousel.hide {
                display: none;
            }
            .collection_carousel {
                display: block;
                overflow-x: hidden;
                padding: 0 1rem;
                margin-top: 1rem;
                margin-bottom: 0;
            }
            .collection_carousel figure {
                padding: 0;
                margin: 0;
            }

            /*ORIGNAL*/
            /* .collection_carousel-container {
                max-width: 64px;
                height: 63px;
                margin-bottom: 2rem;
            }
            .collection_carousel-container-image {
                width: 62px;
                height: 62px;
                border-radius: 50%;
                overflow: hidden;
            } */

            /*NUEVO 1*/
            .collection_carousel-container {
                max-width: none;
                width: auto;
                height: auto;
                margin-bottom: 2rem;
                }
                .collection_carousel-container-image {
                width: 100%;
                aspect-ratio: 1/1;
                border-radius: 50%;
                overflow: hidden;
                }
            .collection_carousel__image {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }
            .collection_carousel-container-title {
                color: #000;
                text-align: center;
                font-size: 12px;
                font-style: normal;
                font-weight: 400;
                line-height: 12px;
                margin-bottom: 0;
            }
            @media screen and (min-width: 768px) {
                .collection_carousel {
                    display: none;
                }
                div#swiper-wrapper-desktop {
                    justify-content: center;
                    gap:11px;
                }
                .collection_carousel {
                    margin-top: 0;
                }
                .collection_carousel-container {
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    text-align: center;
                    width: clamp(64px, 8vw, 140px); /* asegura consistencia */
                    }
                    .collection_carousel-container-title {
                    display: block;
                    text-align: center;
                    font-size: 16px;
                    line-height: 1.2;
                    /* margin-top: 0.25rem;
                    word-break: break-word; */
                    max-width: 100%;
                    }

            }
            @media (max-width:767px) and (min-width:590px) {
                /* .collection_carousel {
                    margin-top: 4.8rem
                } */

                div#swiper-wrapper-desktop {
                    justify-content: center;
                    gap:11px;
                }
            }

            @media (max-width:767px){
                /*ORIGNAL*/
                .collection_carousel-container {
                    max-width: 64px;
                    height: 63px;
                    margin-bottom: 2rem;
                }
                .collection_carousel-container-image {
                    width: 62px;
                    height: 62px;
                    border-radius: 50%;
                    overflow: hidden;
                } 
            }

        </style>

        <section id="section-{{ section.id }}" data-section-id="{{ section.id }}" data-section-type="collection-carousel" class="main-carousel">

            <div class="swiper collection_carousel">
                <div id="swiper-wrapper-desktop" class="swiper-wrapper">

                    {%- for block in section.blocks -%}
                        {%- if block.settings.image != blank -%}
                            <a href="{{block.settings.link}}" 
                            class="collection_carousel-container swiper-slide {% if block.settings.link contains request.path and request.path != '/collections/best-selling-bras' %}hide-bubble{% endif %}">

                                {% comment %} <figure class="collection_carousel-container-image">
                                    {{ block.settings.image | image_url: width: 100 | image_tag:
                                        class: 'collection_carousel__image',
                                        height: 'auto', loading: 'lazy'
                                    }}
                                </figure> {% endcomment %}
                                <figure class="collection_carousel-container-image">
                                {{ block.settings.image | image_url: width: 700 | image_tag:
                                    class: 'collection_carousel__image',
                                    widths: '120, 240, 360, 480, 640, 700',
                                    sizes: '(max-width: 480px) 24vw, (max-width: 768px) 16vw, 8vw',
                                    loading: 'lazy'
                                }}
                                </figure>

                                <h2 class="collection_carousel-container-title">{{block.settings.title }}</h2>
                            </a>
                        {%- endif -%}
                    {%- endfor -%}
                </div>
            </div> 

        </section>

        <script>
        document.addEventListener("DOMContentLoaded", () => {
            const sliderContainer = document.querySelector('.main-carousel');
            if (sliderContainer && !sliderContainer?.classList?.contains('hide')) {
            const header = document.querySelector('.section-header-collection .h1');
                if (header) {
                    header.style.paddingTop = '10px';
                }
            }
            
            new Swiper('.swiper.collection_carousel', {
                direction: 'horizontal',
                autoHeight: false,
                slidesPerView: 'auto',
                spaceBetween: 18
            });

            const collectionCarousel = document.querySelector('.collection_carousel');
            const currentUrl = window.location.href;
            const urlToShowCarousel = [
                '/collections/womens-bras',
                '/collections/best-selling-bras',
                '/collections/bra-packs',
                '/collections/womens-wireless-bras',
                '/collections/womens-underwire-bras',
                '/collections/the-nursing-bra'
            ];

            if (window.innerWidth > 767) {
                if (urlToShowCarousel.some(url => currentUrl.includes(url))) {
                    collectionCarousel.style.setProperty('display', 'flex', 'important');
                }
            }
            
        });
        </script>

        
    {%- endif -%}
{%- endif -%}
{% schema %}
{
    "name": "Collection carousel",
    "max_blocks": 18,
    "settings": [
        {
            "type": "collection_list",
            "id": "show_in_collection",
            "label": "Display in collections..."
        }
    ],
    "blocks": [
    {
        "type": "collection",
        "name": "Collection",
        "settings": [
            {
                "type": "image_picker",
                "id": "image",
                "label": "Image",
                "info": "1120 x 1200px .jpg recommended"
            }, 
            {
                "type": "text",
                "id": "title",
                "label": "Heading",
                "default": "Collection name"
            }, 
            {
                "type": "url",
                "id": "link",
                "label": "link"
            }
        ]
    }
    ],
    "presets": [
        {
            "category": "Collection",
            "name": "Collection carousel",
            "settings": {}
        }
    ]
}
{% endschema %}