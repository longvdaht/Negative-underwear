{%- if section.blocks.size > 0 -%}
    <section class="card-grid-section section-max-width page-width {{ section.settings.class_container }}">
        <div class="grid__container">
            {%- for block in section.blocks -%}
                <div class="col-grid">
                    <a href="{{ block.settings.link }}">
                        <img src="{{ block.settings.image | img_url: 'grande' }}" 
                            data-src="{{ block.settings.image | img_url: 'grande' }}"
                            class="lazyload" loading="lazy" alt="{{ block.settings.image.alt }}" />
                        <span>
                            {{ block.settings.title }} 
                            <span class="icon-col">&gt;</span>
                        </span>
                    </a>
                </div>
            {%- endfor -%}
        </div>
    </section>


    <style>
        .card-grid-section {
            padding-top: 20px;
            padding-bottom: 42px;
        }
        .grid__container.hidden {
            display: none;
        }
        .grid__container {
            display: grid;
            grid-template-columns: 1fr 1fr; 
            grid-template-rows: 1fr 1fr;
            gap: 16px 8px;
            width: 100%;
        }
        .grid__container .col-grid {
            display: flex;
            flex-direction: column;
            height: auto;
            overflow: hidden;
        }
        .grid__container a {
            text-decoration: none;
            color: currentColor;
            display: flex;
            flex-direction: column;
            gap: 8px;
            overflow: hidden;
        }
        .grid__container img {
            width: 100%;
            object-fit: cover;
            object-position: center center;
        }
        .grid__container span {
            margin-bottom: 0;
            font-size: 16px;
            line-height: 1;
            font-family: nimbus-sans, sans-serif;
            font-weight: 100;
            letter-spacing: -.02em;
            font-style: normal;
        }
        .grid__container .icon-col {
            white-space: nowrap;
            transition: transform .1s ease;
            overflow: hidden;
        }
        @media (min-width: 768px) {
            .card-grid-section {
                {% comment %} padding-top: 20px; {% endcomment %}
                padding-bottom: 83px;
            }
            .grid__container {
                grid-template-columns: repeat(4, 1fr);
                grid-template-rows: 1fr;
                gap: 30px;
            }

            .grid__container span {
                font-size: 18px;
            }
        }
    </style>
{%- endif -%}
{% schema %}
{
  "name": "Card grid section",
  "tag": "section",
  "class": "main-container-grid hide",
  "settings": [
    {
        "type": "text",
        "id": "class_container",
        "label": "Class Container"
    }
  ],
    "blocks": [
        {
            "type": "card",
            "name": "Card",
            "settings": [
                    {
                        "type": "image_picker",
                        "id": "image",
                        "label": "Image"
                    },
                    {
                        "type": "text",
                        "id": "title",
                        "label": "Title",
                        "default": "Shop The Red Edit"
                    },
                    {
                        "type": "url",
                        "id": "link",
                        "label": "Link"
                    }
                ]
        }
    ],
    "presets": [
        {
            "name": "Card grid section"
        }
    ]
}
{% endschema %}