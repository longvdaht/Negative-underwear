<ul class="footer__list-social list-unstyled list-social">
  {%- if settings.social_facebook_link != blank -%}
    <li class="list-social__item">
      <a aria-label="Visit us on Facebook! Opens External Webpage" href="{{ settings.social_facebook_link }}" class="link list-social__link" target="_blank" >
        <span class="icon icon-facebook"></span>
      </a>
    </li>
  {%- endif -%}
  {%- if settings.social_pinterest_link != blank -%}
    <li class="list-social__item">
      <a aria-label="Visit us on Pinterest! Opens External Webpage" href="{{ settings.social_pinterest_link }}" class="link list-social__link" target="_blank" >
